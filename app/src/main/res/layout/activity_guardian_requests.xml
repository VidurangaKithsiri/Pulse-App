<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F4F8FA">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Guardian connections" android:textSize="26sp" android:textStyle="bold" android:textColor="#183344" />
        <Button android:id="@+id/guardianLogout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Log out" android:textColor="#FFFFFF" android:backgroundTint="#1769AA" />
        <CheckBox android:id="@+id/guardianConsent" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="I agree to also act as a guardian and receive alerts" android:textColor="#183344" />
        <Button android:id="@+id/sendGuardianRequest" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Search / send guardian request" android:textColor="#FFFFFF" android:backgroundTint="#1769AA" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="My accepted guardians" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="16dp" android:textColor="#183344" />
        <LinearLayout android:id="@+id/acceptedGuardiansList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:focusable="true" android:focusableInTouchMode="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sent requests" android:textSize="20sp" android:textStyle="bold" android:textColor="#183344" />
        <LinearLayout android:id="@+id/sentRequestsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Incoming requests and connections" android:textSize="20sp" android:textStyle="bold" android:textColor="#183344" />
        <LinearLayout android:id="@+id/requestsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Emergency alerts" android:textSize="22sp" android:textStyle="bold" android:textColor="#183344" />
        <LinearLayout android:id="@+id/guardianAlertsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>